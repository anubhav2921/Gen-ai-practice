31. Complete Line Plot Example

import matplotlib.pyplot as plt

epochs = [1, 2, 3, 4, 5]
loss = [0.9, 0.7, 0.55, 0.4, 0.3]

plt.figure(figsize=(8, 5))

plt.plot(
    epochs,
    loss,
    color="blue",
    marker="o",
    markersize=8,
    markerfacecolor="red",
    linewidth=3,
    label="Training Loss"
)

plt.xlabel("Epoch", fontsize=12, color="green")
plt.ylabel("Loss", fontsize=12, color="purple")
plt.title("GenAI Model Training Loss", fontsize=16, color="darkorange")

plt.grid(True, linestyle="--", alpha=0.5)
plt.legend()

plt.savefig("genai_training_loss.png", dpi=300, bbox_inches="tight")
plt.show()

