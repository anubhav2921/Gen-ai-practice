33. Basic Workflow to Remember

import matplotlib.pyplot as plt

# Data
x = [1, 2, 3, 4, 5]
y = [2, 4, 3, 7, 6]

# Create plot
plt.plot(x, y)

# Add information
plt.xlabel("X")
plt.ylabel("Y")
plt.title("My Plot")

# Improve appearance
plt.grid(True)
plt.legend()

# Show
plt.show()